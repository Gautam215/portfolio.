# Copy to .env.local for local runs, or set these in your hosting dashboard
# (Vercel → Project → Settings → Environment Variables). Never commit a
# real .env.local — it is gitignored, and this file holds no secrets.

# Database.
# Local / single-server use (Node's built-in SQLite, no external service).
# Relative paths are scoped to ./data/ by the app.
DATABASE_PATH="data/portfolio.db"

# Production on Vercel: set DATABASE_URL to a managed Postgres URL and the
# app switches to Postgres automatically (SQLite cannot persist on Vercel —
# its serverless storage is ephemeral and not shared between instances).
# Neon (free tier) example — use the POOLED connection string for serverless,
# and keep sslmode=require for Neon:
#   DATABASE_URL="postgres://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# Leave DATABASE_URL unset to keep using SQLite locally.
# DATABASE_URL=""

# Contact email destination (defaults to ak9724068@gmail.com if unset).
CONTACT_EMAIL_TO="ak9724068@gmail.com"

# SMTP for contact-form delivery. Leave all four unset and messages are
# saved to the database with emailStatus "no_smtp" — the form says so
# honestly instead of pretending an email was sent.
# Gmail configuration (confirmed 2026-10-26; requires 2-Step Verification,
# which is already enabled on this account):
# - Use a Gmail App Password (NOT your Google account password).
# - The code reads SMTP_PASS — that is the variable name for the
#   "SMTP_PASSWORD" value in the Gmail settings list. There is no
#   SMTP_PASSWORD variable in this app; setting that name alone
#   would leave email unconfigured.
# - SMTP_SECURE=false is correct for port 587 (STARTTLS), not a mistake.
# - NEVER paste the App Password in chat, in this file, or in any
#   committed file. Set SMTP_PASS directly in Vercel → Settings →
#   Environment Variables (production), or in a local .env.local
#   that is gitignored and never committed.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="ak9724068@gmail.com"
SMTP_PASS=""
SMTP_FROM="ak9724068@gmail.com"
