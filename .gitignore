# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# contact messages contain other people's personal data — never commit them
/data/messages.json
# SQLite database (contains contact messages) — never commit it
*.db
*.db-journal
# .env.example is committed intentionally; real env files are ignored above
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
